<!-- ============================================================
     ESTILO — CSS da PV. Paleta vem de src/styles/global.css (var(--wine) etc,
     apelidados aqui pra --ac/--ac-d/--ac-l/--gold). Alguns box-shadow/rgba()
     abaixo têm um tom lilás fixo (glow/sombra) — puramente decorativo; ajuste
     se sua paleta for muito diferente de roxo, mas não é obrigatório.
     ============================================================ -->
<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap");

  /* Paleta herdada de src/styles/global.css (--wine/--pix/--cream/--blush/--star) —
     NÃO redefina cores aqui. Pra rebrandear pra outro produto, edite só o
     bloco "PALETA DO PRODUTO" em global.css; estes tokens são só apelidos
     usados pelo CSS desta página. --ink/--muted/--bg/--border/--porc/--serif/
     --sans/--rad são neutros de tipografia/layout, não fazem parte da marca —
     opcionalmente ajustáveis, mas raramente precisam mudar entre produtos. */
  :root {
    --ac: var(--wine);
    --ac-d: color-mix(in oklab, var(--wine) 82%, black);
    --ac-l: var(--cream);
    --ink: #1e0e2e;
    --muted: #6b5b78;
    --bg: #FCFBFF;
    --border: #ece5f8;
    --ok: #16a34a;
    --gold: var(--star);
    --serif: 'Fraunces', Georgia, serif;
    --sans: 'Plus Jakarta Sans', system-ui, sans-serif;
    --porc: #FDFAFF;
    /* --blush não é redeclarado aqui — herda direto de global.css pra evitar
       ciclo de var() (self-reference deixaria a propriedade inválida). */
    --line: var(--border);
    --rad: 22px;
  }
  body { font-family: var(--sans); color: var(--ink); background: var(--bg); -webkit-font-smoothing: antialiased; overflow-x: hidden }
  img { max-width: 100%; display: block }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 18px }
  .ic { width: 16px; height: 16px; display: inline-block; vertical-align: middle; flex: none }
  .stars { display: inline-flex; gap: 1px; color: var(--gold) }
  .stars .ic { width: 15px; height: 15px }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; background: linear-gradient(135deg, var(--ac), var(--ac-d)); color: #fff; border: none; border-radius: 100px; font: 800 16px/1 var(--sans); padding: 17px 26px; cursor: pointer; box-shadow: 0 10px 24px -8px rgba(124, 58, 237, .6); transition: transform .15s, box-shadow .15s; text-decoration: none }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -8px rgba(124, 58, 237, .7) }
  .btn:active { transform: translateY(0) }
  .btn.big { width: 100%; padding: 18px; font-size: 18px }
  .pulse { animation: pulse 2.2s ease-in-out infinite }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 10px 24px -8px rgba(124, 58, 237, .6), 0 0 0 0 rgba(124, 58, 237, .4) }
    50% { box-shadow: 0 10px 24px -8px rgba(124, 58, 237, .6), 0 0 0 14px rgba(124, 58, 237, 0) }
  }
  /* TOPBAR */
  .topbar { background: var(--ink); color: #fff; font-size: 12.5px; font-weight: 700; padding: 9px 12px }
  .topbar b { color: #ffd7ff; font-weight: 800 }
  .tb-rot { position: relative; height: 18px; overflow: hidden; max-width: 640px; margin: 0 auto }
  .tb-item { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 7px; white-space: nowrap; opacity: 0; transform: translateY(-110%); transition: opacity .5s ease, transform .55s cubic-bezier(.16, 1, .3, 1) }
  .tb-item.on { opacity: 1; transform: translateY(0) }
  .tb-item.out { opacity: 0; transform: translateY(110%) }
  .tb-item .ic { width: 14px; height: 14px; flex: 0 0 auto }

  .nav { position: sticky; top: 0; z-index: 40; background: rgba(255, 255, 255, .92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border) }
  .nav .wrap { display: flex; align-items: center; justify-content: center; height: 62px }
  .brand { font-family: var(--serif); font-size: 27px; font-weight: 600; letter-spacing: -.02em }
  .brand span { color: var(--ac) }

  .orbs { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: -1 }
  .orb { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .35 }
  .orb.a { width: 340px; height: 340px; background: #d4baff; top: -80px; left: -70px; animation: drift 22s ease-in-out infinite }
  .orb.b { width: 300px; height: 300px; background: #e6d6ff; top: 44%; right: -90px; opacity: .28; animation: drift 26s ease-in-out infinite reverse }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) }
    50% { transform: translate(30px, 40px) }
  }

  /* HERO */
  .hero { padding: 24px 0 8px }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; align-items: center }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; gap: 14px } }
  .hero-img-wrap { position: relative }
  .hero-img-wrap img { width: 100%; border-radius: 22px; box-shadow: 0 30px 60px -30px rgba(124, 58, 237, .55); aspect-ratio: 1/1; object-fit: cover }
  .disc-badge { position: absolute; top: 14px; left: 14px; width: 68px; height: 68px; border-radius: 50%; background: linear-gradient(140deg, var(--ac), var(--ac-d)); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 12px 26px -8px rgba(124, 58, 237, .75); border: 2px solid rgba(255, 255, 255, .55) }
  .disc-badge b { font-family: var(--serif); font-size: 20px; font-weight: 600; line-height: 1 }
  .disc-badge span { font-size: 8px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; margin-top: 2px; opacity: .95 }
  .rate-row { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); font-weight: 600; margin-bottom: 10px; flex-wrap: wrap }
  .h1 { font-family: var(--serif); font-size: 34px; line-height: 1.06; font-weight: 600; letter-spacing: -.02em; margin-bottom: 8px }
  .h1 em { color: var(--ac-d); font-style: italic }
  @media (max-width: 820px) { .h1 { font-size: 27px } }
  .sub { font-size: 14.5px; color: var(--muted); line-height: 1.45; margin-bottom: 14px; max-width: 46ch }
  .kit-lbl { font-size: 12px; font-weight: 800; color: var(--ac-d); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 2px }
  .price-row { display: flex; align-items: baseline; gap: 12px }
  .price-now { font-family: var(--serif); font-size: 42px; font-weight: 600; color: var(--ac-d); letter-spacing: -.02em }
  .price-old { font-size: 18px; color: var(--muted); text-decoration: line-through }
  .price-hint { font-size: 12.5px; color: var(--ok); font-weight: 700; margin: 3px 0 14px; display: flex; align-items: center; gap: 6px }

  /* KIT SELECTOR (do modelo 62 do template) */
  .ksel { margin: 10px 0 16px }
  .of-kits { display: flex; flex-direction: column; gap: 10px }
  .of-kit { position: relative; display: flex; align-items: center; gap: 12px; padding: 14px; background: #fff; border: 2px solid var(--border); border-radius: 16px; cursor: pointer; text-align: left; font-family: inherit; transition: .18s; width: 100% }
  .of-kit:hover { border-color: var(--ac) }
  .of-kit.on { border-color: var(--ac); background: linear-gradient(180deg, var(--ac-l), #fff); box-shadow: 0 12px 26px -12px rgba(124, 58, 237, .6) }
  .of-kit .radio { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--border); flex: none; position: relative; transition: .2s }
  .of-kit.on .radio { border-color: var(--ac); background: var(--ac) }
  .of-kit.on .radio::after { content: ""; position: absolute; inset: 4px; background: #fff; border-radius: 50% }
  .of-kit .imgs { display: flex; gap: 2px; flex: none }
  .of-kit .imgs img { width: 34px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border); background: #fff }
  .of-kit .imgs img:nth-child(2) { margin-left: -12px }
  .of-kit .imgs img:nth-child(3) { margin-left: -12px }
  .of-kit .kinfo { flex: 1; min-width: 0 }
  .of-kit .kname { display: block; font-weight: 800; font-size: 14px; color: var(--ink); line-height: 1.15 }
  .of-kit .kper { display: block; font-size: 11.5px; color: var(--muted); font-weight: 600; margin-top: 2px }
  .of-kit .kprice { text-align: right; flex: none }
  .of-kit .kprice b { display: block; font-family: var(--serif); font-size: 18px; font-weight: 600; color: var(--ac-d); line-height: 1 }
  .of-kit .kprice s { display: block; font-size: 11px; color: var(--muted); margin-top: 2px }
  .of-kit .tag { position: absolute; top: -8px; left: 14px; background: linear-gradient(135deg, var(--ac), var(--ac-d)); color: #fff; font-size: 9px; font-weight: 900; letter-spacing: .06em; padding: 3px 10px; border-radius: 100px; box-shadow: 0 5px 12px -3px rgba(124, 58, 237, .85); text-transform: uppercase }

  .urgency { background: var(--ac-l); border: 1px solid var(--border); border-radius: 14px; padding: 11px 14px; margin-bottom: 14px }
  .urgency-top { display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; font-weight: 700; margin-bottom: 7px }
  .urgency-top b { color: var(--ac-d) }
  .urgency-top .l { display: inline-flex; align-items: center; gap: 6px; color: var(--ink) }
  .bar { height: 8px; background: #fff; border-radius: 100px; overflow: hidden; border: 1px solid var(--border) }
  .bar > i { display: block; height: 100%; width: 20%; background: linear-gradient(90deg, var(--ac), var(--ac-d)); border-radius: 100px }

  .trust-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 8px; margin-top: 16px }
  .trust-row div { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 12px; color: var(--muted); font-weight: 600 }
  .trust-row .ico { width: 28px; height: 28px; border-radius: 8px; background: var(--ac-l); display: flex; align-items: center; justify-content: center; color: var(--ac-d) }

  .sec { padding: 42px 0 }
  .sec h2 { font-family: var(--serif); font-size: 28px; font-weight: 600; text-align: center; letter-spacing: -.02em; margin-bottom: 6px }
  .sec p.lead { text-align: center; color: var(--muted); font-size: 14.5px; margin-bottom: 22px }

  /* OCASIÕES IDEAIS */
  .occ-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 640px; margin: 0 auto 22px }
  .occ { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 108px; padding: 16px 10px; border-radius: 16px; background: #fff; border: 1px solid var(--border); box-shadow: 0 10px 24px -18px rgba(0, 0, 0, .2) }
  .occ .ic { width: 22px; height: 22px; color: var(--ac-d) }
  .occ span { font-size: 12px; font-weight: 700; color: var(--ink); text-align: center; line-height: 1.25 }

  /* VIDEO MARQUEE */
  .vmarquee { overflow: hidden; position: relative; padding: 6px 0; -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent) }
  .vtrack { display: flex; width: max-content; animation: vscroll 40s linear infinite }
  @keyframes vscroll { from { transform: translateX(0) } to { transform: translateX(-50%) } }
  .vmarquee:hover .vtrack { animation-play-state: paused }
  .vidcard { flex: none; width: 186px; margin-right: 14px; border-radius: 16px; overflow: hidden; position: relative; background: #000; aspect-ratio: 9/16; box-shadow: 0 16px 34px -20px rgba(0, 0, 0, .5) }
  .vidcard video { width: 100%; height: 100%; object-fit: cover; display: block }
  .vidcard .cap { position: absolute; left: 11px; right: 11px; bottom: 11px; color: #fff; text-shadow: 0 1px 6px rgba(0, 0, 0, .92); display: flex; flex-direction: column; gap: 1px }
  .vidcard .cap-top { display: flex; align-items: center; gap: 4px; font-size: 13px; font-weight: 800; line-height: 1.15 }
  .vidcard .cap-vf { display: inline-flex; flex: none; width: 15px; height: 15px }
  .vidcard .cap-vf svg { width: 15px; height: 15px; filter: drop-shadow(0 1px 2px rgba(0, 0, 0, .35)) }
  .vidcard .cap-fol { font-size: 10.5px; font-weight: 700; opacity: .93 }

  /* 3 PASSOS */
  .scn { position: relative; --p: 0; background: var(--porc); margin: 0 auto }
  .scn h1, .scn h2, .scn h3 { font-family: var(--serif); font-weight: 600; line-height: 1.12; letter-spacing: -.01em }
  .sv { position: relative; width: min(100%, 560px); margin: 0 auto; height: min(78svh, 600px); overflow: hidden; border-radius: 24px; display: flex; flex-direction: column; align-items: center; justify-content: center }
  #scn-passos { padding: 42px 16px 0 }
  .ps-sv { background: var(--porc); box-shadow: 0 20px 50px -24px rgba(124, 58, 237, .5) }
  .ps-tint { position: absolute; inset: 0; pointer-events: none; transition: opacity .5s ease }
  .ps-tint-1 { background: radial-gradient(75% 60% at 50% 8%, #F5EEFB 0%, transparent 75%); opacity: var(--a1, 0) }
  .ps-tint-2 { background: radial-gradient(75% 60% at 50% 8%, #E7D9F6 0%, transparent 75%); opacity: var(--a2, 0) }
  .ps-tint-3 { background: radial-gradient(75% 60% at 50% 8%, #DFEDF6 0%, transparent 75%); opacity: var(--a3, 0) }
  .ps-rail { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); z-index: 5; display: flex; flex-direction: column; align-items: center; gap: 0; height: 200px }
  .ps-rail-track { position: relative; width: 2px; flex: 1; background: var(--line); border-radius: 2px; overflow: hidden }
  .ps-rail-fill { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: var(--ac); transform-origin: top; transform: scaleY(var(--f, 0)); transition: transform .45s ease }
  /* Visual continua 26px (não cabe maior no rail), mas o ::before estende a
     área de toque real pra 44x44 — mesma técnica do .vl-dots abaixo. */
  .ps-dot { position: relative; width: 26px; height: 26px; border-radius: 50%; background: #fff; border: 1.5px solid var(--line); display: grid; place-items: center; font-size: .62rem; font-weight: 800; color: var(--muted); font-family: var(--sans); z-index: 2; transition: all .3s; cursor: pointer; padding: 0 }
  .ps-dot::before { content: ""; position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; transform: translate(-50%, -50%) }
  .ps-dot.on { background: var(--ac); border-color: var(--ac); color: #fff; box-shadow: 0 0 0 5px rgba(124, 58, 237, .18) }
  .ps-act { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 34px 30px 30px 52px; gap: 10px; opacity: var(--av, 0); transform: translateY(calc((1 - var(--av, 0))*34px)); pointer-events: none; transition: opacity .45s ease, transform .45s cubic-bezier(.16, 1, .3, 1) }
  .ps-act-1 { --av: var(--a1, 0) } .ps-act-2 { --av: var(--a2, 0) } .ps-act-3 { --av: var(--a3, 0) }
  .ps-eyebrow { font-size: .66rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: var(--ac-d) }
  .ps-eyebrow b { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--ac); color: #fff; font-size: .7rem; margin-right: 6px; vertical-align: middle }
  .ps-act img { width: min(40vw, 190px); height: min(34svh, 240px); object-fit: contain; filter: drop-shadow(0 20px 30px rgba(124, 58, 237, .22)); transform: scale(calc(.88 + var(--av, 0)*.12)) rotate(calc((1 - var(--av, 0))*5deg)) }
  .ps-ghost { position: absolute; left: 50%; top: 31%; z-index: 0; transform: translate(-50%, -50%) translateY(calc((.5 - var(--av, 0))*90px)); font-family: var(--serif); font-style: italic; font-weight: 600; line-height: 1; white-space: nowrap; font-size: clamp(5rem, 27vw, 11rem); color: transparent; -webkit-text-stroke: 1.5px rgba(124, 58, 237, .16); pointer-events: none }
  .ps-fig { position: relative; display: grid; place-items: center; width: 100% }
  .ps-fig img { position: relative; z-index: 2 }
  .ps-glow { position: absolute; width: min(58vw, 300px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(255, 255, 255, .95) 0%, rgba(255, 255, 255, 0) 68%) }
  .ps-fig::after { content: ""; position: absolute; bottom: -8px; width: 36%; height: 14px; border-radius: 50%; background: radial-gradient(ellipse, rgba(124, 58, 237, .3), transparent 70%); filter: blur(2px); transform: scaleX(calc(.7 + var(--av, 0)*.3)) }
  .ps-part { position: absolute; border-radius: 50%; pointer-events: none; z-index: 1 }
  .ps-pa { width: 13px; height: 13px; left: 15%; top: 10%; transform: translateY(calc(var(--av, 0)*-48px)) }
  .ps-pb { width: 8px; height: 8px; right: 17%; top: 24%; transform: translateY(calc(var(--av, 0)*-84px)) }
  .ps-pc { width: 6px; height: 6px; left: 25%; bottom: 4%; transform: translateY(calc(var(--av, 0)*-30px)) }
  .ps-pd { width: 10px; height: 10px; right: 23%; bottom: 14%; transform: translateY(calc(var(--av, 0)*-64px)) }
  .ps-act-1 .ps-part { background: #fff; box-shadow: inset -2px -2px 4px rgba(124, 58, 237, .3), 0 2px 6px rgba(122, 74, 51, .14) }
  .ps-act-2 .ps-part { background: var(--ac); opacity: .45 }
  .ps-act-3 .ps-part { background: #6ec1ea; opacity: .55 }
  .ps-act h3 { font-size: clamp(1.6rem, 6.6vw, 2.4rem) }
  .ps-act h3 em { color: var(--ac-d) }
  .ps-act p { color: var(--muted); max-width: 420px; font-size: clamp(.9rem, 3.5vw, 1.02rem) }
  .ps-chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 4px }
  .ps-chips span { padding: 6px 13px; border-radius: 100px; background: #fff; border: 1px solid var(--line); font-size: .7rem; font-weight: 700; color: var(--ink); box-shadow: 0 4px 10px rgba(124, 58, 237, .1) }
  .ps-chips span::before { content: ""; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: var(--ac); margin-right: 7px; vertical-align: 2px }
  .ps-chips span:nth-child(1) { transform: translateY(calc((1 - var(--av, 0))*20px)) }
  .ps-chips span:nth-child(2) { transform: translateY(calc((1 - var(--av, 0))*36px)) }
  .ps-chips span:nth-child(3) { transform: translateY(calc((1 - var(--av, 0))*52px)) }
  @keyframes spin { to { rotate: 360deg } }
  .ps-ring { position: absolute; inset: 0; margin: auto; width: min(64vw, 320px); aspect-ratio: 1; border-radius: 50%; border: 1.5px dashed rgba(124, 58, 237, .4); animation: spin 26s linear infinite; pointer-events: none }
  .ps-ring::before { content: ""; position: absolute; top: -5px; left: 50%; width: 9px; height: 9px; border-radius: 50%; background: var(--ac); box-shadow: 0 0 10px rgba(124, 58, 237, .8) }
  .ps-ring-2 { width: min(80vw, 396px); border: 1px solid rgba(124, 58, 237, .14); animation: spin 44s linear infinite reverse }
  .ps-ring-2::before { width: 6px; height: 6px; background: var(--gold); box-shadow: 0 0 8px rgba(240, 165, 0, .8) }
  .ps-tag { position: absolute; z-index: 3; max-width: 118px; padding: 8px 11px; border-radius: 14px; text-align: left; background: rgba(255, 255, 255, .82); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid var(--line); box-shadow: 0 10px 24px rgba(124, 58, 237, .14); font-size: .58rem; font-weight: 600; line-height: 1.35; color: var(--muted); opacity: clamp(0, calc(var(--av, 0)*2.2 - .55), 1) }
  .ps-tag b { display: block; color: var(--ac-d); font-size: .72rem; margin-bottom: 2px }
  .ps-tag-l { top: 25%; left: 4% }
  .ps-tag-r { top: 25%; right: 4% }

  /* VIDEO PRINCIPAL */
  .mainvid { text-align: center; padding: 22px 0 38px; background: linear-gradient(180deg, var(--ac-l), #fff) }
  .mainvid .box { position: relative; max-width: 420px; margin: 0 auto; border-radius: 20px; overflow: visible; box-shadow: 0 26px 54px -26px rgba(0, 0, 0, .55); background: #000 }
  .mainvid video { width: 100%; display: block; border-radius: 20px }
  .mainvid .hint { margin-top: 12px; font-size: 12.5px; color: var(--muted); font-weight: 600; display: inline-flex; align-items: center; gap: 6px }
  .mv-play { position: absolute; inset: 0; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; border: none; cursor: pointer; background: linear-gradient(180deg, rgba(20, 10, 15, .12), rgba(20, 10, 15, .42)); transition: opacity .3s; border-radius: 20px; overflow: hidden }
  .mv-ico { width: 76px; height: 76px; border-radius: 50%; background: rgba(255, 255, 255, .96); display: flex; align-items: center; justify-content: center; box-shadow: 0 12px 30px -8px rgba(0, 0, 0, .5); animation: mvpulse 2s ease-in-out infinite }
  .mv-ico svg { width: 30px; height: 30px; color: var(--ac-d); margin-left: 4px }
  @keyframes mvpulse { 0%, 100% { transform: scale(1) } 50% { transform: scale(1.08) } }
  .mv-lbl { display: inline-flex; align-items: center; gap: 6px; color: #fff; font-size: 13px; font-weight: 800; background: rgba(0, 0, 0, .34); padding: 6px 15px; border-radius: 100px; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px) }
  .mainvid .box.playing .mv-play { opacity: 0; pointer-events: none }
  .vbadge { position: absolute; z-index: 6; max-width: 66%; opacity: 0; transform: translateY(16px) scale(.92); animation: vb-in .7s cubic-bezier(.16, 1, .3, 1) forwards; pointer-events: none }
  .mainvid .box.playing .vbadge { opacity: 0 !important; transition: opacity .3s; animation: none }
  .vb-glass { display: inline-flex; align-items: center; gap: 9px; padding: 8px 14px 8px 8px; border-radius: 15px; background: rgba(255, 255, 255, .72); -webkit-backdrop-filter: blur(16px) saturate(1.5); backdrop-filter: blur(16px) saturate(1.5); border: 1px solid rgba(255, 255, 255, .85); box-shadow: 0 14px 34px -12px rgba(0, 0, 0, .5), inset 0 1px 0 rgba(255, 255, 255, .7); animation: vbf 5.4s ease-in-out infinite }
  .vb-ic { width: 30px; height: 30px; border-radius: 10px; background: linear-gradient(140deg, var(--ac), var(--ac-d)); display: flex; align-items: center; justify-content: center; flex: 0 0 auto; box-shadow: 0 6px 14px -4px rgba(0, 0, 0, .55) }
  .vb-ic svg { width: 16px; height: 16px; color: #fff }
  .vbadge b { font-size: 12.5px; font-weight: 800; line-height: 1.12; letter-spacing: -.01em; color: var(--ink) }
  .vbadge.vb1 { top: 16px; left: 16px; animation-delay: .25s }
  .vbadge.vb2 { top: 45%; right: -16px; animation-delay: .6s }
  .vbadge.vb3 { bottom: 18px; left: -16px; animation-delay: .95s }
  @keyframes vb-in { to { opacity: 1; transform: translateY(0) scale(1) } }
  @keyframes vbf { 0%, 100% { transform: translateY(0) rotate(0) } 50% { transform: translateY(-7px) rotate(-.6deg) } }
  @media (max-width: 560px) { .vbadge { max-width: 73% } .vb-glass { gap: 7px; padding: 6px 11px 6px 6px } .vb-ic { width: 26px; height: 26px } .vb-ic svg { width: 14px; height: 14px } .vbadge b { font-size: 11px } }

  /* OCASIÕES IDEAIS — nota de uso */
  .ba2-note { margin: 14px auto 0; max-width: 420px; text-align: center; font-size: .7rem; color: var(--muted); line-height: 1.5 }

  /* DEPOIMENTOS — grid de reviews COM foto anexada (mescla dos prints antigos) */
  .revs-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; max-width: 900px; margin: 0 auto }
  @media (max-width: 640px) { .revs-grid { grid-template-columns: 1fr; max-width: 400px } }
  .rev { background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 18px; box-shadow: 0 10px 30px -22px rgba(0, 0, 0, .2); display: flex; flex-direction: column; gap: 8px }
  .rev .top { display: flex; align-items: center; justify-content: space-between }
  .rev .nm { font-weight: 800; font-size: 14px; color: var(--ink) }
  .rev .vf { font-size: 11px; color: var(--ok); font-weight: 700; display: inline-flex; align-items: center; gap: 4px; background: #eafaf0; padding: 3px 8px; border-radius: 100px }
  .rev p { font-size: 13.5px; color: #4a3540; line-height: 1.55 }
  .rev .rev-pic { width: 100%; margin-top: 4px; border-radius: 12px; border: 1px solid var(--border); aspect-ratio: 1; object-fit: cover; background: #f4f0fa }

  /* GARANTIA */
  .guar-wrap { position: relative; max-width: 640px; margin: 0 auto }
  .guar { position: relative; z-index: 1; max-width: 640px; margin: 0 auto; background: #fff; border: 1px solid var(--border); border-radius: 20px; padding: 26px; text-align: center; box-shadow: 0 14px 40px -28px rgba(0, 0, 0, .3) }
  .guar .seal { width: 66px; height: 66px; border-radius: 50%; background: var(--ac-l); display: flex; align-items: center; justify-content: center; color: var(--ac-d); margin: 0 auto 12px }
  .guar .seal .ic { width: 32px; height: 32px }
  .guar h3 { font-family: var(--serif); font-size: 22px; font-weight: 600; margin-bottom: 8px }
  .guar h3 span { display: inline-block; color: #fff; background: linear-gradient(135deg, var(--ac), var(--ac-d)); padding: 2px 13px; border-radius: 100px; font-family: var(--sans); font-size: 18px; font-weight: 800; vertical-align: middle }
  .guar p { color: #5f4550; font-size: 14px; line-height: 1.6 }
  .guar p b { color: var(--ac-d) }
  .coin { position: absolute; z-index: 3; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(135deg, #ffe08a, #f0a500); color: #fff; font-weight: 900; box-shadow: 0 8px 18px -6px rgba(240, 165, 0, .6), inset 0 2px 4px rgba(255, 255, 255, .5); border: 2px solid rgba(255, 255, 255, .8); pointer-events: none; text-shadow: 0 1px 2px rgba(180, 120, 0, .4) }
  .coin.c1 { width: 46px; height: 46px; font-size: 14px; top: -20px; left: -14px; animation: coinf 4.5s ease-in-out infinite }
  .coin.c2 { width: 36px; height: 36px; font-size: 13px; top: -16px; right: -12px; animation: coinf 5.2s ease-in-out infinite .6s }
  .coin.c3 { width: 32px; height: 32px; font-size: 13px; bottom: 10px; left: -16px; animation: coinf 4.8s ease-in-out infinite 1.1s }
  @keyframes coinf { 0%, 100% { transform: translateY(0) rotate(-6deg) } 50% { transform: translateY(-12px) rotate(6deg) } }
  @media (max-width: 520px) { .coin.c1 { left: -8px } .coin.c2 { right: -8px } .coin.c3 { left: -10px } }

  /* ANCORA DE VALOR */
  .value { background: linear-gradient(180deg, var(--ac-l), #fff) }
  .val-emote { font-family: var(--serif); font-size: 24px; font-weight: 600; text-align: center; max-width: 24ch; margin: 0 auto 26px; line-height: 1.32; color: var(--ink) }
  .val-emote em { color: var(--ac-d); font-style: italic }
  .vl-sv { height: min(42svh, 300px); min-height: 260px; background: none; box-shadow: none }
  .vlb { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 18px 22px; text-align: center; opacity: var(--bv, 0); transform: translateY(calc((1 - var(--bv, 0))*24px)); pointer-events: none; transition: opacity .45s ease, transform .45s cubic-bezier(.16, 1, .3, 1); gap: 8px }
  .vl-ico { width: 62px; height: 62px; border-radius: 20px; background: #fff; border: 1px solid var(--border); display: grid; place-items: center; color: var(--ac-d); box-shadow: 0 10px 24px -12px rgba(124, 58, 237, .4) }
  .vl-ico svg { width: 30px; height: 30px }
  .vlb b { font-family: var(--serif); font-size: 40px; font-weight: 600; color: var(--ac-d); line-height: 1 }
  .vl-lab { font-size: 13px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .06em }
  .vlb p { color: var(--muted); max-width: 320px; font-size: 14px; line-height: 1.5 }
  .vl-dots { position: absolute; bottom: 12px; left: 0; right: 0; display: flex; justify-content: center; gap: 8px; z-index: 5 }
  /* Bolinha visual continua pequena (8px), mas a área clicável real é 44x44 via
     ::before invisível centralizado — abaixo disso o dedo erra o alvo no celular. */
  .vl-dots button { position: relative; width: 8px; height: 8px; border-radius: 50%; border: none; background: var(--border); cursor: pointer; transition: .2s; padding: 0 }
  .vl-dots button::before { content: ""; position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; transform: translate(-50%, -50%) }
  .vl-dots button.on { background: var(--ac); width: 24px; border-radius: 100px }

  /* FAQ */
  .faq-list { max-width: 700px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 16px; overflow: hidden }
  .faq-item summary { list-style: none; cursor: pointer; padding: 16px 44px 16px 18px; font-size: 14.5px; font-weight: 700; color: var(--ink); position: relative; display: flex; align-items: center; min-height: 44px }
  .faq-item summary::-webkit-details-marker { display: none }
  .faq-ic { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: var(--ac); transition: transform .25s cubic-bezier(.16,1,.3,1); flex: none }
  .faq-item[open] .faq-ic { transform: translateY(-50%) rotate(45deg) }
  .faq-body { padding: 0 18px 16px; font-size: 13.5px; color: var(--muted); line-height: 1.6 }
  .faq-item summary:focus-visible { outline: 2px solid var(--ac); outline-offset: -2px; border-radius: 12px }

  /* FOOTER */
  .ft { background: #201230; color: #cdbcd5; margin-top: 0 }
  .ft .wrap { padding: 32px 18px 0 }
  .ft-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 30px }
  @media (max-width: 720px) { .ft-grid { grid-template-columns: 1fr; gap: 24px } }
  .ft .brand { color: #fff; font-size: 24px }
  .ft p { font-size: 13px; line-height: 1.6; margin: 10px 0 14px; max-width: 34ch }
  .ft h4 { color: #fff; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px }
  .ft a { display: flex; align-items: center; gap: 8px; color: #cdbcd5; text-decoration: none; font-size: 13px; margin-bottom: 9px; transition: .15s }
  .ft a:hover { color: #fff }
  .ft-badges { display: flex; gap: 8px; flex-wrap: wrap }
  .ft-badges span { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .1); padding: 6px 11px; border-radius: 100px }
  .ft-bottom { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-top: 1px solid rgba(255, 255, 255, .1); margin-top: 32px; padding: 16px 18px 88px; font-size: 11.5px; color: #8f7d96 }
  @media (min-width: 721px) { .ft-bottom { padding-bottom: 24px } }

  /* STICKY CTA */
  .stickycta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: rgba(255, 255, 255, .96); backdrop-filter: blur(10px); border-top: 1px solid var(--border); box-shadow: 0 -8px 24px -18px rgba(0, 0, 0, .3); transform: translateY(115%); transition: transform .35s cubic-bezier(.16, 1, .3, 1); will-change: transform }
  .stickycta.show { transform: translateY(0) }
  .stickycta.is-covered { visibility: hidden }
  .stickycta .wrap { display: flex; align-items: center; gap: 14px; padding: 11px 18px }
  .sk-kits { display: flex; gap: 6px; flex: 1; min-width: 0 }
  .sk-kit { flex: 1; border: 1.5px solid var(--border); background: #fff; border-radius: 10px; padding: 6px 4px; cursor: pointer; font-family: inherit; line-height: 1.12; transition: .15s; text-align: center }
  .sk-kit span { display: block; font-size: 10px; font-weight: 700; color: var(--muted) }
  .sk-kit b { display: block; font-size: 12.5px; color: var(--ac-d); font-weight: 800; margin-top: 1px }
  .sk-kit.on { border-color: var(--ac); background: var(--ac-l) }
  .stickycta .btn { white-space: nowrap; padding: 13px 18px; font-size: 14px }

  /* ── FOCO DE TECLADO ────────────────────────────────────────────────────
     Nenhuma regra no arquivo zera outline, então o navegador já mostra um
     foco padrão — mas só troca pelo roxo da marca em elementos interativos
     custom (o resto do :focus-visible nativo do browser já é suficiente). */
  .btn:focus-visible,
  .of-kit:focus-visible,
  .sk-kit:focus-visible,
  .vidcard:focus-visible,
  .ft a:focus-visible,
  .nav a:focus-visible {
    outline: 2px solid var(--ac);
    outline-offset: 3px;
  }

  /* ── REVEAL ON SCROLL — stagger por seção (via :nth-of-type) ──────────── */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .6s cubic-bezier(.16,1,.3,1), transform .6s cubic-bezier(.16,1,.3,1) }
  .reveal.in { opacity: 1; transform: none }
  .no-js .reveal { opacity: 1; transform: none; transition: none }
  .reveal:nth-of-type(1) { transition-delay: 0ms }
  .reveal:nth-of-type(2) { transition-delay: 80ms }
  .reveal:nth-of-type(3) { transition-delay: 160ms }
  .reveal:nth-of-type(4) { transition-delay: 240ms }
  .reveal:nth-of-type(5) { transition-delay: 320ms }
  .reveal:nth-of-type(6) { transition-delay: 400ms }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none }
  }

  /* ═════════════════════════ v6 · polish visual ═════════════════════════ */

  /* Hero rating badge premium — score em serif, meta em small caps */
  .hero-rating { display: inline-flex; align-items: center; gap: 12px; padding: 8px 14px 8px 10px; margin-bottom: 14px; background: color-mix(in oklab, var(--ac-l) 55%, white); border: 1px solid color-mix(in oklab, var(--ac) 20%, transparent); border-radius: 100px; box-shadow: 0 8px 24px -18px rgba(83, 40, 133, .35); max-width: fit-content }
  .hero-rating .hr-score { font: 700 24px/1 var(--serif); color: var(--ac-d); letter-spacing: -.02em; padding: 4px 10px; background: #fff; border-radius: 100px; box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ac) 12%, transparent) }
  .hero-rating .hr-mid { display: inline-flex; flex-direction: column; gap: 3px }
  .hero-rating .hr-mid .stars { display: inline-flex; gap: 1px; color: var(--gold); line-height: 1 }
  .hero-rating .hr-mid .stars .ic { width: 13px; height: 13px }
  .hero-rating .hr-meta { font-size: 11px; color: var(--muted); font-weight: 600; letter-spacing: .02em; text-transform: uppercase }
  .hero-rating .hr-meta b { color: var(--ink); font-weight: 800 }

  /* mainvid — layout 2 colunas em desktop com legenda ao lado do vídeo */
  .mainvid .mv-side { display: none }
  @media (min-width: 900px) {
    .mainvid { padding: 56px 0 64px }
    .mainvid > .wrap { max-width: 1080px }
    .mainvid .mv-grid { display: grid; grid-template-columns: minmax(0, 460px) 1fr; gap: 56px; align-items: center; text-align: left }
    .mainvid .mv-side { display: block; order: -1 }
    .mainvid .mv-side h2 { text-align: left; margin: 0 0 12px; font-size: clamp(24px, 3vw, 30px) }
    .mainvid .mv-side .lead { text-align: left; max-width: 42ch; margin: 0 }
    .mainvid .mv-quotes { margin-top: 22px; display: flex; flex-direction: column; gap: 14px }
    .mainvid .mv-quotes .mvq { display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border-radius: 14px; background: #fff; box-shadow: 0 12px 32px -22px rgba(83,40,133,.32); border: 1px solid color-mix(in oklab, var(--ac) 8%, transparent) }
    .mainvid .mv-quotes .mvq .qic { flex: none; width: 34px; height: 34px; border-radius: 100px; background: color-mix(in oklab, var(--ac) 12%, white); display: grid; place-items: center; color: var(--ac-d) }
    .mainvid .mv-quotes .mvq p { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--ink) }
    .mainvid .mv-quotes .mvq p b { color: var(--ac-d) }
    .mainvid .box { margin: 0 }
  }

  /* Cards de review — elevação + hover sutil */
  .rev { transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s cubic-bezier(.16,1,.3,1) }
  .rev.rev-photo { box-shadow: 0 12px 34px -22px rgba(83, 40, 133, .5), 0 2px 4px -2px rgba(0, 0, 0, .05); border-color: color-mix(in oklab, var(--ac) 10%, var(--border)) }
  @media (hover: hover) {
    .rev.rev-photo:hover { transform: translateY(-3px); box-shadow: 0 22px 44px -22px rgba(83, 40, 133, .55), 0 4px 8px -4px rgba(0, 0, 0, .06) }
  }

  /* Âncora de valor — big-number statement */
  .val-hero { text-align: center; max-width: 24ch; margin: 0 auto 26px }
  .val-hero .vh-eyebrow { display: block; font-size: 11.5px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--ac-d); margin-bottom: 6px }
  .val-hero .vh-num { display: block; font: 700 clamp(56px, 12vw, 88px) / 1 var(--serif); color: var(--ac-d); letter-spacing: -.03em; margin: 4px 0 6px }
  .val-hero .vh-num small { font: 500 .32em/1 var(--serif); color: var(--muted); letter-spacing: 0; vertical-align: 1.4em }
  .val-hero .vh-sub { display: block; font: 500 15px/1.4 var(--sans); color: var(--muted) }
  .val-hero .vh-sub b { color: var(--ink) }
  .val-hero .vh-rule { display: block; height: 1px; width: 60px; margin: 18px auto 0; background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--ac) 55%, transparent), transparent) }

  /* CTAs — shimmer premium no hover (só desktop hover) */
  .btn { position: relative; overflow: hidden; isolation: isolate }
  .btn::after { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, .28) 50%, transparent 70%); transform: translateX(-120%); pointer-events: none; z-index: 1 }
  @media (hover: hover) {
    .btn:hover::after { animation: btn-shimmer .95s cubic-bezier(.16,1,.3,1) 1 }
  }
  @keyframes btn-shimmer {
    0% { transform: translateX(-120%) }
    100% { transform: translateX(120%) }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn::after { display: none }
  }

  /* FAQ chevron: rota 45→135deg (X) e easing mais suave */
  .faq-ic { transition: transform .32s cubic-bezier(.16,1,.3,1) }
  .faq-item[open] .faq-ic { transform: translateY(-50%) rotate(135deg) }
</style>

<!-- ============================================================
     JS — port das interações do template + hooks pro checkout Astro
     ============================================================ -->
<script>
  import { setSelectedKit } from "../scripts/cart-state";
  import { KITS, DEFAULT_KIT_INDEX, discountPercent } from "../data/kits";

  function money(v: number) { return "R$ " + v.toFixed(2).replace(".", ",") }

  // ── TOPBAR rotativa ────────────────────────────────────────────────────────
  (function () {
    const items = Array.from(document.querySelectorAll<HTMLElement>(".tb-rot .tb-item"));
    if (items.length < 2) return;
    let i = 0;
    if (!items[0].classList.contains("on")) items[0].classList.add("on");
    setInterval(() => {
      const cur = items[i], nx = (i + 1) % items.length;
      cur.classList.remove("on"); cur.classList.add("out");
      items[nx].classList.add("on");
      setTimeout(() => cur.classList.remove("out"), 600);
      i = nx;
    }, 3000);
  })();

  // ── KIT SELECTOR ──────────────────────────────────────────────────────────
  // Coordena visual do hero + cards + sticky bar + estado no localStorage
  // (via setSelectedKit) — que o CheckoutModal e criar-pix.ts leem depois.
  function selectKit(i: number) {
    const k = KITS[i];
    const disc = discountPercent(k);
    document.querySelectorAll<HTMLElement>(".of-kit").forEach((el) => {
      const active = Number(el.dataset.i) === i;
      el.classList.toggle("on", active);
      el.setAttribute("aria-checked", String(active));
    });
    document.querySelectorAll<HTMLElement>(".sk-kit").forEach((el) => {
      const active = Number(el.dataset.idx) === i;
      el.classList.toggle("on", active);
      el.setAttribute("aria-checked", String(active));
    });
    const priceEl = document.getElementById("hero-price");
    const oldEl = document.getElementById("hero-old");
    const badgeEl = document.getElementById("disc-badge");
    const kitEl = document.getElementById("hero-kit");
    if (priceEl) priceEl.textContent = money(k.price);
    if (oldEl) oldEl.textContent = money(k.original);
    if (badgeEl) badgeEl.textContent = "-" + disc + "%";
    if (kitEl) kitEl.textContent = `${k.name} · R$ ${k.perUnit.toFixed(2).replace(".", ",")} por frasco`;
    setSelectedKit(i);
  }
  document.querySelectorAll<HTMLElement>(".of-kit").forEach((el) => {
    el.addEventListener("click", () => selectKit(Number(el.dataset.i)));
  });
  document.querySelectorAll<HTMLElement>(".sk-kit").forEach((el) => {
    el.addEventListener("click", () => selectKit(Number(el.dataset.idx)));
  });
  // Boot: garante que o localStorage começa com o DEFAULT_KIT_INDEX
  // pra CheckoutModal ler o valor certo antes do usuário mexer no seletor.
  selectKit(DEFAULT_KIT_INDEX);

  // ── 3 PASSOS ───────────────────────────────────────────────────────────────
  let psAuto: number | null = null, psIdx = 0;
  function showPasso(i: number, fromAuto = false) {
    const sec = document.getElementById("scn-passos"); if (!sec) return;
    if (!fromAuto && psAuto !== null) { window.clearInterval(psAuto); psAuto = null }
    psIdx = i;
    for (let j = 0; j < 3; j++) sec.style.setProperty(`--a${j + 1}`, j === i ? "1" : "0");
    sec.querySelectorAll<HTMLElement>(".ps-dot").forEach((el) => el.classList.toggle("on", Number(el.dataset.dot) === i));
    const f1 = document.getElementById("psFill1"), f2 = document.getElementById("psFill2");
    if (f1) f1.style.setProperty("--f", i >= 1 ? "1" : "0");
    if (f2) f2.style.setProperty("--f", i >= 2 ? "1" : "0");
  }
  document.querySelectorAll<HTMLElement>("#scn-passos .ps-dot").forEach((el) => {
    el.addEventListener("click", () => showPasso(Number(el.dataset.dot)));
  });
  if (document.getElementById("scn-passos")) {
    psAuto = window.setInterval(() => showPasso((psIdx + 1) % 3, true), 4200);
  }

  // ── ANCORA DE VALOR ────────────────────────────────────────────────────────
  let vlAuto: number | null = null, vlIdx = 0;
  function showValor(i: number, fromAuto = false) {
    const sec = document.getElementById("scn-valor"); if (!sec) return;
    if (!fromAuto && vlAuto !== null) { window.clearInterval(vlAuto); vlAuto = null }
    vlIdx = i;
    for (let j = 0; j < 2; j++) sec.style.setProperty(`--b${j + 1}`, j === i ? "1" : "0");
    sec.querySelectorAll<HTMLElement>(".vl-dots button").forEach((el) => el.classList.toggle("on", Number(el.dataset.vl) === i));
  }
  document.querySelectorAll<HTMLElement>("#scn-valor .vl-dots button").forEach((el) => {
    el.addEventListener("click", () => showValor(Number(el.dataset.vl)));
  });
  if (document.getElementById("scn-valor")) {
    vlAuto = window.setInterval(() => showValor((vlIdx + 1) % 2, true), 4600);
  }

  // ── VIDEO PRINCIPAL: click-to-sound ────────────────────────────────────────
  (function () {
    const v = document.getElementById("mv-video") as HTMLVideoElement | null;
    const box = document.getElementById("mv-box");
    const btn = document.getElementById("mv-play");
    if (!v || !box || !btn) return;
    btn.addEventListener("click", () => {
      v.muted = false; v.loop = false; v.controls = true;
      try { v.currentTime = 0 } catch {}
      v.play().catch(() => {});
      box.classList.add("playing");
    });
    v.addEventListener("play", () => { if (!v.muted) box.classList.add("playing") });
    v.addEventListener("pause", () => { if (!v.ended && !v.muted) box.classList.remove("playing") });
    v.addEventListener("ended", () => box.classList.remove("playing"));
  })();

  // ── VIDEOS DO MARQUEE: autoplay silencioso ────────────────────────────────
  document.querySelectorAll<HTMLVideoElement>(".vidcard video").forEach((v) => {
    v.muted = true;
    v.play().catch(() => {});
  });

  // ── REVEAL ON SCROLL ──────────────────────────────────────────────────────
  const rio = new IntersectionObserver(
    (es) => es.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add("in"); rio.unobserve(e.target) } }),
    { threshold: 0.05, rootMargin: "0px 0px -8% 0px" }
  );
  const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
  requestAnimationFrame(() => {
    const h = window.innerHeight;
    revealEls.forEach((el) => {
      const top = el.getBoundingClientRect().top;
      if (top < h * 0.95) el.classList.add("in");
      else rio.observe(el);
    });
  });

  // ── STICKY CTA: histerese pra não flip-flopar quando .buycta encosta na dobra
  // Só ARMA depois que o usuário passou do hero. Enquanto armado, exige o
  // Comprar do hero ficar totalmente fora da tela (rootMargin negativo grande)
  // pra APARECER, e volta a ficar visível DE VERDADE pra DESAPARECER — sem
  // esse buffer o sticky ficava alternando entre show/hide a cada 1px de scroll
  // e visualmente parecia que o rodapé estava "tremendo".
  (function () {
    const sticky = document.querySelector<HTMLElement>(".stickycta");
    if (!sticky) return;
    let armed = false;
    let heroCtaVisible = true;
    function sync() { sticky!.classList.toggle("show", armed && !heroCtaVisible); }

    // Só observa o CTA do hero (o principal) — os outros .buycta ficam pra ancoragem
    // visual, mas não devem controlar aparição/desaparição do sticky.
    const heroCta = document.querySelector<HTMLElement>(".hero .buycta");
    if (heroCta) {
      const io = new IntersectionObserver(([e]) => { heroCtaVisible = e.isIntersecting; sync(); }, {
        threshold: 0,
        rootMargin: "-40px 0px -40px 0px",
      });
      io.observe(heroCta);
    }
    // Só ativa depois de rolar ~600px — evita aparecer no primeiro paint em mobile
    // quando o hero ainda pode estar parcialmente abaixo da dobra.
    function onScroll() {
      if (!armed && window.scrollY > 600) {
        armed = true;
        sync();
        window.removeEventListener("scroll", onScroll);
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>

