---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import CheckoutModal from "../components/CheckoutModal.astro";
import { KITS, DEFAULT_KIT_INDEX, discountPercent } from "../data/kits";
import { SITE } from "../config/site.config";
import heroImage from "../assets/products/hero.webp";
import vibrationImage from "../assets/products/vibration.webp";
import blunnImage from "../assets/products/blunn.webp";
import feroImage from "../assets/products/fero.webp";
import cliente1 from "../assets/reviews/cliente-1.webp";
import cliente2 from "../assets/reviews/cliente-2.webp";
import cliente3 from "../assets/reviews/cliente-3.webp";
import cliente4 from "../assets/reviews/cliente-4.webp";

const title = SITE.productName;
const description = "Kit com 3 body splash masculinos de 200ml: Vibration (cítrico), Blunn (amadeirado, inspirado no Bleu de Chanel) e Infalível Fero (aquático). Uma fragrância pra cada momento do dia, com frete grátis e pagamento no Pix.";
const ogImage = await getImage({ src: heroImage, width: 1200, height: 1200 });

const initialKit = KITS[DEFAULT_KIT_INDEX];
const initialDiscount = discountPercent(initialKit);

const brl = (v: number) => v.toFixed(2).replace(".", ",");

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: title,
  description,
  brand: { "@type": "Brand", name: SITE.storeName },
  image: ogImage.src,
  offers: {
    "@type": "Offer",
    priceCurrency: "BRL",
    price: initialKit.price.toFixed(2),
    availability: "https://schema.org/InStock",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    reviewCount: "312",
  },
};
---
<Layout title={`${title} | ${SITE.storeName}`} description={description} ogImage={ogImage.src}>
  <div class="orbs" aria-hidden="true"><span class="orb a"></span><span class="orb b"></span></div>

  <!-- Ícones (symbols) reutilizáveis -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></symbol>
    <symbol id="i-truck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4h13v11H1z"/><path d="M14 8h4l4 4v3h-8"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></symbol>
    <symbol id="i-star" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></symbol>
    <symbol id="i-zap" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></symbol>
    <symbol id="i-arrows" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 7 4 12 9 17"/><polyline points="15 7 20 12 15 17"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.6 5.4L19 9l-5.4 1.6L12 16l-1.6-5.4L5 9l5.4-1.6z"/></symbol>
    <symbol id="i-tooth" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-2.5 0-4.5 1.6-4.5 4.2 0 1 .2 1.7.5 2.7.3 1 .6 2.2.7 4 .1 1.3.5 2.1 1.1 2.1.7 0 .9-.9 1.1-2.3.2-1.5.5-2.3 1.1-2.3.6 0 .9.8 1.1 2.3.2 1.4.4 2.3 1.1 2.3.6 0 1-.8 1.1-2.1.1-1.8.4-3 .7-4 .3-1 .5-1.7.5-2.7C16.5 4.6 14.5 3 12 3Z"/></symbol>
    <symbol id="i-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 4 13H2s1-6 8-6 12 3 12 3-2 12-11 10z"/><path d="M2 22l7-7"/></symbol>
    <symbol id="i-coffee" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></symbol>
    <symbol id="i-chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></symbol>
    <symbol id="i-pix" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l4 4-4 4-4-4z"/><path d="M2 12l4-4 4 4-4 4z"/><path d="M22 12l-4-4-4 4 4 4z"/><path d="M12 14l4 4-4 4-4-4z"/></symbol>
    <symbol id="i-vol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-vf" viewBox="0 0 40 40"><path fill="#7c3aed" d="M19.998 3.094L14.638 0l-2.972 5.15H5.432v6.354L0 14.64 3.094 20 0 25.359l5.432 3.137v5.905h5.975L14.638 40l5.36-3.094L25.358 40l3.232-5.6h6.162v-6.01L40 25.359 36.905 20 40 14.641l-5.248-3.03v-6.46h-6.419L25.358 0l-5.36 3.094z"/><path fill="#fff" d="M18 27.36l-6.6-6.6 2.83-2.82L18 21.72l7.77-7.77 2.83 2.83z"/></symbol>
  </svg>

  <!-- ================ TOPBAR ROTATIVA ================ -->
  <div class="topbar">
    <div class="tb-rot" aria-live="polite">
      <span class="tb-item on"><svg class="ic"><use href="#i-spark"/></svg> <b>3 fragrâncias</b> em um kit só</span>
      <span class="tb-item"><svg class="ic"><use href="#i-vol"/></svg> Fixação de <b>3 a 4 horas</b> · reaplique quando quiser</span>
      <span class="tb-item"><svg class="ic"><use href="#i-truck"/></svg> Frete Expresso <b>em até 24h</b> pra todo Brasil</span>
      <span class="tb-item"><svg class="ic"><use href="#i-shield"/></svg> <b>7 dias</b> de garantia · troca sem burocracia</span>
    </div>
  </div>

  <!-- ================ NAV ================ -->
  <nav class="nav">
    <div class="wrap">
      <div class="brand">{SITE.storeName}<span>.</span></div>
    </div>
  </nav>

  <!-- ================ HERO ================ -->
  <section class="hero"><div class="wrap"><div class="hero-grid">
    <div class="hero-img-wrap">
      <span class="disc-badge"><b id="disc-badge">-{initialDiscount}%</b><span>Off hoje</span></span>
      <img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={SITE.productName} loading="eager">
    </div>
    <div>
      <div class="hero-rating reveal">
        <span class="hr-score">4,8</span>
        <span class="hr-mid">
          <span class="stars">
            <svg class="ic"><use href="#i-star"/></svg><svg class="ic"><use href="#i-star"/></svg><svg class="ic"><use href="#i-star"/></svg><svg class="ic"><use href="#i-star"/></svg><svg class="ic"><use href="#i-star"/></svg>
          </span>
          <span class="hr-meta"><b>312</b> avaliações · <b>4,1 mil</b> vendidos</span>
        </span>
      </div>
      <h1 class="h1">Kit Body Splash Vibration + Blunn + Infalível Fero<br>3 fragrâncias premium por menos de <em>R$ 23 cada</em></h1>
      <p class="sub">Vibration (cítrico e refinado), Blunn (amadeirado, inspirado no Bleu de Chanel) e Infalível Fero (aquático, criação autoral): uma fragrância pra cada momento do seu dia. Frascos de 200ml, fixação de 3 a 4 horas.</p>
      <div class="kit-lbl" id="hero-kit">{initialKit.name} · R$ {brl(initialKit.perUnit)} por frasco</div>
      <div class="price-row">
        <span class="price-now" id="hero-price">R$ {brl(initialKit.price)}</span>
        <span class="price-old" id="hero-old">R$ {brl(initialKit.original)}</span>
      </div>
      <div class="price-hint"><svg class="ic"><use href="#i-pix"/></svg> Pagamento à vista no PIX · liberação na hora</div>

      <div class="ksel">
        <div class="of-kits" id="ofKits" role="radiogroup" aria-label="Escolha a quantidade de frascos">
          {KITS.map((k) => (
            <button type="button" role="radio" aria-checked={k.i === DEFAULT_KIT_INDEX ? "true" : "false"} class:list={["of-kit", { on: k.i === DEFAULT_KIT_INDEX }]} data-i={k.i}>
              {k.badge && <span class="tag">{k.badge}</span>}
              <span class="radio"></span>
              <span class="imgs">
                {Array.from({ length: k.qty }).map(() => (
                  <img src={heroImage.src} alt="" loading="lazy">
                ))}
              </span>
              <span class="kinfo">
                <span class="kname">{k.name}</span>
                <span class="kper" data-per={k.i}>{k.hint}</span>
              </span>
              <span class="kprice">
                <b data-price={k.i}>R$ {brl(k.price)}</b>
                <s data-old={k.i}>R$ {brl(k.original)}</s>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="urgency">
        <div class="urgency-top">
          <span class="l"><svg class="ic" style="color:var(--ac-d)"><use href="#i-zap"/></svg> Preço promocional</span>
          <b>Válido enquanto durar o estoque</b>
        </div>
        <div class="bar"><i></i></div>
      </div>

      <button data-open-checkout class="btn big pulse buycta" type="button">QUERO O MEU AGORA</button>

      <div class="trust-row">
        <div><span class="ico"><svg class="ic"><use href="#i-lock"/></svg></span> Pagamento seguro</div>
        <div><span class="ico"><svg class="ic"><use href="#i-truck"/></svg></span> Envio em 24h</div>
        <div><span class="ico"><svg class="ic"><use href="#i-shield"/></svg></span> 7 dias de garantia</div>
        <div><span class="ico"><svg class="ic"><use href="#i-zap"/></svg></span> Aprovação na hora</div>
      </div>
    </div>
  </div></div></section>

  <!-- ================ VIDEO MARQUEE ================ -->
  <section class="sec"><div class="wrap">
    <h2 class="reveal">Quem já usou, mostrou</h2>
    <p class="lead reveal">Vídeos reais de clientes que compraram {SITE.productName}</p>
  </div>
  <div class="vmarquee"><div class="vtrack" id="vtrack">
    <div class="vidcard"><video src="/videos/showcase-1.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-2.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-3.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-4.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-5.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-6.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-1.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-2.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-3.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-4.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-5.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
    <div class="vidcard"><video src="/videos/showcase-6.mp4" muted loop playsinline preload="metadata"></video><span class="cap"><span class="cap-top">Cliente verificado <span class="cap-vf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span></span><span class="cap-fol">Compra verificada</span></span></div>
  </div></div>
  </section>

  <!-- ================ 3 FRAGRÂNCIAS DO KIT ================ -->
  <section class="sec scn" id="scn-passos" style="--a1: 1; --a2: 0; --a3: 0;"><div class="wrap">
    <h2 class="reveal">Um kit, três personalidades</h2>
    <p class="lead reveal">Toque nos números pra conhecer cada fragrância</p>
  </div>
    <div class="sv ps-sv">
      <div class="ps-tint ps-tint-1"></div>
      <div class="ps-tint ps-tint-2"></div>
      <div class="ps-tint ps-tint-3"></div>
      <div class="ps-rail">
        <button type="button" class="ps-dot on" data-dot="0" aria-label="Vibration — frescor cítrico">1</button>
        <span class="ps-rail-track"><i class="ps-rail-fill" id="psFill1" style="--f: 0;"></i></span>
        <button type="button" class="ps-dot" data-dot="1" aria-label="Blunn — elegância amadeirada">2</button>
        <span class="ps-rail-track"><i class="ps-rail-fill" id="psFill2" style="--f: 0;"></i></span>
        <button type="button" class="ps-dot" data-dot="2" aria-label="Infalível Fero — aquático moderno">3</button>
      </div>
      <div class="ps-act ps-act-1">
        <span class="ps-ghost" aria-hidden="true">Vibration</span>
        <span class="ps-eyebrow"><b>1</b> Frescor vibrante</span>
        <div class="ps-fig">
          <i class="ps-glow"></i>
          <i class="ps-ring"></i><i class="ps-ring ps-ring-2"></i>
          <i class="ps-part ps-pa"></i><i class="ps-part ps-pb"></i><i class="ps-part ps-pc"></i><i class="ps-part ps-pd"></i>
          <span class="ps-tag ps-tag-l"><b>Inspirado no Vibrato</b>toranja, bergamota e gengibre</span>
          <span class="ps-tag ps-tag-r"><b>Melhor pra</b>o dia a dia e a rotina de trabalho</span>
          <img src={vibrationImage.src} alt="Body Man Vibration" loading="lazy">
        </div>
        <h3>Body Man <em>VIBRATION</em>.</h3>
        <p>Combina toranja, bergamota, gengibre e notas aromáticas em uma fragrância fresca, refinada e moderna — presença leve e versátil pra qualquer hora do dia.</p>
        <div class="ps-chips"><span>Cítrico</span><span>Toranja & gengibre</span><span>Uso diário</span></div>
      </div>
      <div class="ps-act ps-act-2">
        <span class="ps-ghost" aria-hidden="true">Blunn</span>
        <span class="ps-eyebrow"><b>2</b> Elegância aromática</span>
        <div class="ps-fig">
          <i class="ps-glow"></i>
          <i class="ps-ring"></i><i class="ps-ring ps-ring-2"></i>
          <i class="ps-part ps-pa"></i><i class="ps-part ps-pb"></i><i class="ps-part ps-pc"></i><i class="ps-part ps-pd"></i>
          <span class="ps-tag ps-tag-l"><b>Inspirado no Bleu de Chanel</b>perfil cítrico e amadeirado</span>
          <span class="ps-tag ps-tag-r"><b>Melhor pra</b>reuniões e ocasiões sofisticadas</span>
          <img src={blunnImage.src} alt="Body Man Blunn" loading="lazy">
        </div>
        <h3>Body Man <em>BLUNN</em>.</h3>
        <p>Apresenta um perfil cítrico, aromático e amadeirado que transmite sofisticação e confiança — uma assinatura olfativa elegante pra qualquer momento.</p>
        <div class="ps-chips"><span>Amadeirado</span><span>Inspirado no Bleu de Chanel</span><span>Sofisticado</span></div>
      </div>
      <div class="ps-act ps-act-3">
        <span class="ps-ghost" aria-hidden="true">Fero</span>
        <span class="ps-eyebrow"><b>3</b> Frescor aquático</span>
        <div class="ps-fig">
          <i class="ps-glow"></i>
          <i class="ps-ring"></i><i class="ps-ring ps-ring-2"></i>
          <i class="ps-part ps-pa"></i><i class="ps-part ps-pb"></i><i class="ps-part ps-pc"></i><i class="ps-part ps-pd"></i>
          <span class="ps-tag ps-tag-l"><b>Criação autoral</b>bergamota, limão e algas marinhas</span>
          <span class="ps-tag ps-tag-r"><b>Melhor pra</b>a noite e ocasiões especiais</span>
          <img src={feroImage.src} alt="Body Man Infalível Fero" loading="lazy">
        </div>
        <h3>Body Man <em>INFALÍVEL FERO</em>.</h3>
        <p>Une bergamota, limão e algas marinhas a um fundo confortável de almíscar e cedro — aquático, moderno e agradável, criação autoral Primacial.</p>
        <div class="ps-chips"><span>Aquático</span><span>Almíscar & cedro</span><span>Criação autoral</span></div>
      </div>
    </div>
  </section>

  <!-- ================ VIDEO PRINCIPAL ================ -->
  <section class="mainvid"><div class="wrap">
    <div class="mv-grid">
      <div class="mv-side">
        <h2 class="reveal">Quem já borrifou, aprovou</h2>
        <p class="lead reveal">Um kit pra alternar de fragrância conforme o momento — do dia a dia às ocasiões especiais.</p>
        <div class="mv-quotes reveal">
          <div class="mvq"><span class="qic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span><p>"Fixou o dia inteiro, recebi elogio <b>no trabalho</b>."</p></div>
          <div class="mvq"><span class="qic"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg></span><p><b>3 fragrâncias</b> — uma pra cada momento, sem repetir o cheiro.</p></div>
          <div class="mvq"><span class="qic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span><p>Uso <b>diário</b>, sem enjoar do aroma — reaplico quando quero renovar.</p></div>
        </div>
      </div>
      <div class="box" id="mv-box">
        <video id="mv-video" src="/main-testimonial.mp4" muted autoplay loop playsinline preload="metadata"></video>
