---
import { SHIPPING_OPTIONS, DEFAULT_SHIPPING_ID } from "../data/shipping";
import { KITS, DEFAULT_KIT_INDEX } from "../data/kits";
import { SITE } from "../config/site.config";
import kitImage from "../assets/products/hero.webp";

const initialShipping = SHIPPING_OPTIONS.find((s) => s.id === DEFAULT_SHIPPING_ID) ?? SHIPPING_OPTIONS[0];
// Display inicial usa o kit padrão (KITS[DEFAULT_KIT_INDEX]). O script do checkout
// (mountCheckout → totals()) sobrescreve na abertura com o kit realmente escolhido
// no seletor de kits do hero — via getSelectedKit() do cart-state.
const initialKit = KITS[DEFAULT_KIT_INDEX];
const initialTotal = (initialKit.price + initialShipping.price).toFixed(2).replace(".", ",");
---

<div
  id="checkout-modal"
  class="hidden fixed inset-0 z-[100] flex items-end sm:items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="checkout-title"
>
  <div id="checkout-backdrop" class="absolute inset-0 bg-black/55 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

  <div
    id="checkout-panel"
    class="relative w-full sm:max-w-xl md:max-w-4xl sm:mx-4 bg-white rounded-t-2xl sm:rounded-2xl shadow-2xl max-h-[94dvh] overflow-y-auto translate-y-full sm:translate-y-4 sm:opacity-0 transition-all duration-300 ease-out"
  >
    <!-- Header: título único + close -->
    <div class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-black/10 flex items-center justify-between px-5 py-4">
      <div class="flex items-center gap-3">
        <span class="grid size-9 place-items-center rounded-full bg-[var(--pix)]/12 text-[var(--pix)] shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
          </svg>
        </span>
        <div class="min-w-0">
          <h2 id="checkout-title" class="text-[15.5px] font-bold text-black leading-tight">Finalizar pedido</h2>
          <p class="text-[11px] text-black/45 leading-tight">Ambiente seguro · Pix</p>
        </div>
      </div>
      <button type="button" data-close-checkout aria-label="Fechar" class="grid size-9 place-items-center -mr-1.5 text-black/50 hover:text-black hover:bg-black/5 transition-colors press-feedback rounded-full shrink-0">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- 2 colunas em desktop: form (3fr) + resumo sticky (2fr). Mobile: 1 coluna -->
    <div class="md:grid md:grid-cols-5 md:gap-0">

    <!-- ============ STEP 1: dados + endereço + frete ============ -->
    <form id="checkout-step-1" data-step="1" novalidate class="p-5 sm:p-6 md:p-7 flex flex-col gap-6 md:col-span-3 md:border-r md:border-black/8">

      <!-- 1. Seus dados -->
      <section class="rounded-2xl bg-[var(--cream)]/60 ring-1 ring-black/[0.06] p-4 sm:p-5">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="grid size-7 place-items-center rounded-full bg-[var(--wine)] text-white text-[12px] font-bold shadow-[0_4px_10px_-3px_rgba(124,58,237,0.6)]">1</span>
          <h3 class="text-[11.5px] font-bold uppercase tracking-[0.18em] text-[var(--wine)]">Seus dados</h3>
        </div>
        <div class="flex flex-col gap-3.5">
          <label class="text-sm">
            <span class="block text-black/60 mb-1.5 text-xs font-medium">Nome completo</span>
            <input required name="nome" type="text" autocomplete="name" placeholder="Como está no seu documento" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black placeholder:text-black/30 focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
            <span data-error-for="nome" class="hidden text-xs text-red-600 mt-1"></span>
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <label class="text-sm">
              <span class="block text-black/60 mb-1.5 text-xs font-medium">E-mail</span>
              <input required name="email" type="email" autocomplete="email" placeholder="voce@email.com" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black placeholder:text-black/30 focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
              <span data-error-for="email" class="hidden text-xs text-red-600 mt-1"></span>
            </label>
            <label class="text-sm">
              <span class="block text-black/60 mb-1.5 text-xs font-medium">WhatsApp</span>
              <input required name="telefone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="(00) 00000-0000" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black placeholder:text-black/30 focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
              <span data-error-for="telefone" class="hidden text-xs text-red-600 mt-1"></span>
            </label>
          </div>
          <label class="text-sm">
            <span class="block text-black/60 mb-1.5 text-xs font-medium">CPF</span>
            <input required name="cpf" type="text" inputmode="numeric" placeholder="000.000.000-00" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black placeholder:text-black/30 focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
            <span data-cpf-error class="hidden text-xs text-red-600 mt-1">CPF inválido.</span>
          </label>
        </div>
      </section>

      <!-- 2. Endereço -->
      <section class="rounded-2xl bg-[var(--cream)]/60 ring-1 ring-black/[0.06] p-4 sm:p-5">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="grid size-7 place-items-center rounded-full bg-[var(--wine)] text-white text-[12px] font-bold shadow-[0_4px_10px_-3px_rgba(124,58,237,0.6)]">2</span>
          <h3 class="text-[11.5px] font-bold uppercase tracking-[0.18em] text-[var(--wine)]">Endereço de entrega</h3>
        </div>
        <div class="flex flex-col gap-3.5">
          <div class="grid grid-cols-3 gap-3.5">
            <label class="text-sm col-span-2">
              <span class="block text-black/60 mb-1.5 text-xs font-medium">CEP</span>
              <input required name="cep" type="text" inputmode="numeric" placeholder="00000-000" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black placeholder:text-black/30 focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
              <span data-cep-status class="text-xs text-black/60 mt-1 block"></span>
              <span data-error-for="cep" class="hidden text-xs text-red-600 mt-1"></span>
            </label>
            <label class="text-sm">
              <span class="block text-black/60 mb-1.5 text-xs font-medium">Número</span>
              <input required name="numero" type="text" inputmode="numeric" placeholder="Nº" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black placeholder:text-black/30 focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
              <span data-error-for="numero" class="hidden text-xs text-red-600 mt-1"></span>
            </label>
          </div>
          <label class="text-sm">
            <span class="block text-black/60 mb-1.5 text-xs font-medium">Rua</span>
            <input required name="rua" type="text" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
            <span data-error-for="rua" class="hidden text-xs text-red-600 mt-1"></span>
          </label>
          <label class="text-sm">
            <span class="block text-black/60 mb-1.5 text-xs font-medium">Complemento (opcional)</span>
            <input name="complemento" type="text" placeholder="Apto, bloco, referência…" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black placeholder:text-black/30 focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
          </label>
          <div class="grid grid-cols-3 gap-3.5">
            <label class="text-sm col-span-2">
              <span class="block text-black/60 mb-1.5 text-xs font-medium">Bairro</span>
              <input required name="bairro" type="text" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
              <span data-error-for="bairro" class="hidden text-xs text-red-600 mt-1"></span>
            </label>
            <label class="text-sm">
              <span class="block text-black/60 mb-1.5 text-xs font-medium">UF</span>
              <input required name="uf" type="text" maxlength="2" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black uppercase focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
              <span data-error-for="uf" class="hidden text-xs text-red-600 mt-1"></span>
            </label>
          </div>
          <label class="text-sm">
            <span class="block text-black/60 mb-1.5 text-xs font-medium">Cidade</span>
            <input required name="cidade" type="text" class="w-full rounded-xl border border-black/12 bg-white px-3.5 py-3.5 text-black focus:outline-none focus:ring-2 focus:ring-[var(--wine)]/40 focus:border-[var(--wine)]/50 transition" />
            <span data-error-for="cidade" class="hidden text-xs text-red-600 mt-1"></span>
          </label>
        </div>
      </section>

      <!-- 3. Frete -->
      <section class="rounded-2xl bg-[var(--cream)]/60 ring-1 ring-black/[0.06] p-4 sm:p-5">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="grid size-7 place-items-center rounded-full bg-[var(--wine)] text-white text-[12px] font-bold shadow-[0_4px_10px_-3px_rgba(124,58,237,0.6)]">3</span>
          <h3 class="text-[11.5px] font-bold uppercase tracking-[0.18em] text-[var(--wine)]">Forma de envio</h3>
        </div>
        <div role="radiogroup" aria-label="Opções de frete" class="flex flex-col gap-2.5">
          {SHIPPING_OPTIONS.map((s, i) => (
            <button
              type="button"
              data-shipping-option={s.id}
              role="radio"
              aria-checked={i === 0 ? "true" : "false"}
              class:list={[
                "shipping-card group flex items-start gap-3 rounded-xl border-2 px-4 py-3.5 text-left transition-all press-feedback",
                i === 0 ? "border-[var(--wine)] bg-[var(--blush)] shadow-sm" : "border-black/15 bg-white",
              ]}
            >
              <span class="mt-0.5 grid size-5 flex-shrink-0 place-items-center rounded-full border-2 border-[var(--wine)]">
                <span data-shipping-radio class:list={["size-2.5 rounded-full bg-[var(--wine)] transition-opacity", i === 0 ? "opacity-100" : "opacity-0"]}></span>
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-[13px] font-bold uppercase tracking-wide text-black">{s.name}</span>
                  {i === 0 && (
                    <>
                      <span class="rounded-md bg-[var(--wine)] px-2 py-0.5 text-[9px] font-bold tracking-wider text-white uppercase">Recomendado</span>
                      <span class="rounded-md bg-[var(--pix)]/15 text-[var(--pix)] px-2 py-0.5 text-[9px] font-bold tracking-wide uppercase">Mais escolhido</span>
                    </>
                  )}
                </div>
                <p class="text-xs text-black/60 mt-0.5">{s.description}</p>
              </div>
              <span class="text-sm font-bold text-black shrink-0">
                {s.price > 0 ? `+ R$ ${s.price.toFixed(2).replace(".", ",")}` : "R$ 0,00"}
              </span>
            </button>
          ))}
        </div>
      </section>

      <!-- Total ao vivo (resumo do mobile; no desktop a sidebar já cumpre esse papel) -->
      <div class="md:hidden rounded-2xl bg-white ring-1 ring-[var(--wine)]/15 shadow-[0_16px_40px_-28px_rgba(83,40,133,0.5)] p-4 sm:p-5">
        <div class="flex items-center justify-between text-sm text-black/70">
          <span>Produto</span>
          <span data-live-subtotal class="tabular-nums font-semibold text-black">R$ {initialKit.price.toFixed(2).replace(".", ",")}</span>
        </div>
        <div class="mt-1.5 flex items-center justify-between text-sm text-black/70">
          <span data-live-shipping-name>{initialShipping.name}</span>
          <span data-live-shipping class="tabular-nums font-semibold text-black">{initialShipping.price > 0 ? `R$ ${initialShipping.price.toFixed(2).replace(".", ",")}` : "Grátis"}</span>
        </div>
        <div class="mt-3.5 pt-3.5 border-t border-dashed border-black/12 flex items-end justify-between">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-widest text-[var(--wine)]">Total no Pix</p>
            <p data-live-shipping-hint class="text-[11px] text-black/50 mt-0.5">Recomendamos o Frete Expresso pra receber em até 7 dias.</p>
          </div>
          <span data-live-total class="text-[26px] font-bold text-[var(--wine)] tabular-nums" style="font-family: 'Cormorant Garamond', serif;">R$ {initialTotal}</span>
        </div>
      </div>

      <p data-form-error class="hidden text-sm text-red-600"></p>

      <button
        type="submit"
        class="checkout-cta group relative overflow-hidden bg-gradient-to-br from-[var(--wine)] to-[color-mix(in_oklab,var(--wine)_75%,black)] text-white font-bold uppercase tracking-[0.18em] text-sm py-4 rounded-xl transition-all duration-200 active:scale-[0.985] shadow-[0_10px_28px_-10px_rgba(124,58,237,0.55)] hover:shadow-[0_14px_36px_-10px_rgba(124,58,237,0.7)] flex items-center justify-center gap-2"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Revisar pedido — <span data-step1-cta-total class="tabular-nums">R$ {initialTotal}</span>
      </button>

      <p class="flex items-center justify-center gap-1.5 text-[11px] text-black/50">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Pagamento processado com criptografia de ponta a ponta
      </p>
    </form>

    <!-- Sidebar Resumo (desktop only) ============================ -->
    <aside class="hidden md:flex md:col-span-2 md:flex-col bg-gradient-to-br from-[var(--cream)] to-white">
    <div class="md:sticky md:top-[64px] flex flex-col p-7 md:max-h-[calc(94dvh-64px)] md:overflow-y-auto">
      <div class="mb-5">
        <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--wine)]/70">Resumo do pedido</p>
        {/* "Seu" concorda no masculino — troque pra "Sua" se o nome do seu produto for feminino */}
        <p class="text-lg font-semibold text-black mt-1" style="font-family: 'Cormorant Garamond', serif;">Seu {SITE.productName}</p>
      </div>

      <div class="rounded-2xl bg-white ring-1 ring-black/8 shadow-[0_20px_50px_-25px_rgba(83,40,133,0.35)] p-5 flex items-center gap-4">
        <div class="relative shrink-0 size-20 rounded-xl bg-[var(--blush)] grid place-items-center overflow-hidden">
          <img data-review-kit-image src={kitImage.src} alt={SITE.productName} class="size-full object-cover" />
          <span data-review-kit-qty class="absolute -top-1.5 -right-1.5 grid size-6 place-items-center rounded-full bg-[var(--wine)] text-white text-[11px] font-bold shadow-md">{initialKit.qty}</span>
        </div>
        <div class="flex-1 min-w-0">
          <p data-sidebar-kit-name class="text-sm font-bold text-black leading-tight">{initialKit.name}</p>
          <p data-sidebar-kit-per class="text-xs text-black/55 mt-0.5">R$ {initialKit.perUnit.toFixed(2).replace(".", ",")} por frasco</p>
        </div>
      </div>

      <dl class="mt-5 flex flex-col gap-2 text-sm">
        <div class="flex items-center justify-between">
          <dt class="text-black/60">Subtotal</dt>
          <dd data-sidebar-subtotal class="tabular-nums font-semibold text-black">R$ {initialKit.price.toFixed(2).replace(".", ",")}</dd>
        </div>
        <div class="flex items-center justify-between">
          <dt data-sidebar-shipping-name class="text-black/60">{initialShipping.name}</dt>
          <dd data-sidebar-shipping class="tabular-nums font-semibold text-black">{initialShipping.price > 0 ? `R$ ${initialShipping.price.toFixed(2).replace(".", ",")}` : "Grátis"}</dd>
        </div>
      </dl>

      <div class="mt-4 pt-4 border-t border-dashed border-black/15 flex items-end justify-between">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--wine)]/80">Total no Pix</p>
          <p class="text-[10px] text-black/45 mt-0.5">Aprovação em segundos</p>
        </div>
        <span data-sidebar-total class="text-3xl font-bold text-[var(--wine)] tabular-nums" style="font-family: 'Cormorant Garamond', serif;">R$ {initialTotal}</span>
      </div>

      <div class="mt-auto pt-6 flex flex-col gap-2 text-xs text-black/55">
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--pix)] shrink-0"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          Pagamento criptografado ponta a ponta
        </div>
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--wine)] shrink-0"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          7 dias de garantia — dinheiro de volta
        </div>
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--wine)] shrink-0"><path d="M3 7h13l3 5h2v6h-3a2 2 0 1 1-4 0H10a2 2 0 1 1-4 0H3z"/></svg>
          Envio em 24h úteis · Frete Expresso
        </div>
      </div>
    </div>
    </aside>

    </div><!-- /grid col-span-5 -->

    <!-- ============ STEP 2: revisão + gerar pix ============ -->
    <div id="checkout-step-2" data-step="2" class="hidden p-5 flex flex-col gap-5">
      <button type="button" data-edit-step1 class="self-start flex items-center gap-1.5 text-xs font-semibold text-[var(--wine)] hover:underline">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Editar dados
      </button>

      <div class="rounded-xl border border-black/10 bg-[var(--cream)] p-5">
        <p class="text-[11px] font-bold uppercase tracking-widest text-[var(--wine)] mb-3">Resumo do seu pedido</p>
        <p data-review-offer-name class="text-sm font-semibold text-black leading-snug"></p>
        <div class="mt-2 flex items-center justify-between text-xs text-black/60">
          <span data-review-qty></span>
          <span data-review-subtotal class="tabular-nums"></span>
        </div>
        <div class="mt-1.5 flex items-center justify-between text-xs text-black/60">
          <span data-review-shipping-name></span>
          <span data-review-shipping class="tabular-nums"></span>
        </div>
        <p data-review-address class="mt-3 text-xs text-black/60 leading-relaxed"></p>
        <div class="mt-4 pt-4 border-t border-black/10 flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-widest text-[var(--wine)]">Total no Pix</span>
          <span data-review-total class="text-2xl font-bold text-[var(--wine)] tabular-nums" style="font-family: 'Cormorant Garamond', serif;"></span>
        </div>
      </div>

      <div class="rounded-xl border border-dashed border-[var(--pix)]/40 bg-[color-mix(in_oklab,var(--pix)_6%,white)] p-4">
        <div class="flex items-center gap-2 mb-1">
          <img alt="Pix" class="h-5 w-5" src="/pix-icon.png" />
          <p class="text-sm font-bold text-[var(--pix)]">Pagamento via Pix</p>
        </div>
        <p class="text-xs text-black/70 leading-relaxed">Ao clicar em <strong>Gerar Pix</strong>, você recebe o QR Code e o código copia-e-cola. Confirmação em segundos após o pagamento.</p>
      </div>

      <p data-payment-error class="hidden text-sm text-red-600"></p>

      <button
        type="button"
        data-generate-pix
        class="bg-gradient-to-br from-[var(--wine)] to-[color-mix(in_oklab,var(--wine)_75%,black)] hover:brightness-110 text-white font-bold uppercase tracking-[0.18em] text-sm py-4 rounded-xl transition-all duration-200 active:scale-[0.985] shadow-[0_10px_28px_-10px_rgba(124,58,237,0.55)] hover:shadow-[0_14px_36px_-10px_rgba(124,58,237,0.7)] flex items-center justify-center gap-2 disabled:opacity-60 disabled:pointer-events-none"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        <span data-generate-pix-label>Gerar Pix agora</span>
      </button>

      <p class="flex items-center justify-center gap-1.5 text-[11px] text-black/50">
        Processado pela <strong class="text-black/70">Korvex</strong> · Ambiente PCI-DSS
      </p>
    </div>

    <!-- ============ STEP 3: pagamento pix ============ -->
    <div id="checkout-step-3" data-step="3" class="hidden p-5 flex flex-col gap-4">
      <div class="text-center">
        <div class="mx-auto grid size-12 place-items-center rounded-full bg-[color-mix(in_oklab,var(--pix)_10%,white)] ring-1 ring-[var(--pix)]/30 mb-2">
