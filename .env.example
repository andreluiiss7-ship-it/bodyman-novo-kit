# ─────────────────────────────────────────────────────────────────────────────
#  Variáveis de ambiente. Copie para .env (local) e configure na Vercel (produção).
#  NENHUM segredo fica no código — tudo vem daqui. Veja o README.
# ─────────────────────────────────────────────────────────────────────────────

# Credenciais da Korvex | Plataforma de Pagamentos.
# Gere em: https://app.korvex.com.br/panel/gateway (aba Integrações > API)
# Crie uma credencial dedicada a este produto, com permissão apenas
# "PRODUCER_TRANSACTIONS" (Criar/Consultar Transações) — sem permissão de saque.
KORVEX_PUBLIC_KEY=
KORVEX_SECRET_KEY=

# Vercel KV (Upstash for Redis) — guarda o status de cada pedido entre a criação
# do Pix e a confirmação via webhook. Provisionar em: Vercel > Storage > KV.
# (as variáveis abaixo são preenchidas automaticamente ao conectar o storage)
# ⚠️ Se reusar o MESMO KV entre produtos, troque SITE.kvIndexKey em site.config.ts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend — e-mails transacionais de status do pedido.
# Gere a API key em: https://resend.com/api-keys
RESEND_API_KEY=
# Remetente. Para chegar em clientes reais, use um DOMÍNIO VERIFICADO na Resend.
# Ex: "Minha Loja <pedidos@seudominio.com.br>". Sem isso, o padrão de site.config.ts
# (onboarding@resend.dev) só entrega na sua própria conta Resend.
RESEND_FROM_EMAIL=

# Senha do painel admin (/admin). Use uma senha forte e única por projeto.
ADMIN_PASSWORD=

# UTMify — atribuição de UTM no dashboard de vendas (opcional).
UTMIFY_API_TOKEN=

# Meta Conversions API — reenvia o evento Purchase pro Meta Pixel (SITE.metaPixelId
# em site.config.ts) direto do servidor, no momento em que o webhook da Korvex
# confirma o pagamento. Cobre a compra mesmo se o cliente fechar a aba antes do
# polling do navegador confirmar (o Pixel client-side sozinho perde esses casos).
# Gere em: Events Manager > Configurações de eventos > API de Conversões > Gerar token de acesso.
META_CAPI_TOKEN=
